        addBox(
            builder,
            attributes,
            12f,
            4.5f,
            7f,
            CREAM,
            18f,
            2.25f,
            -3f
        );

        addBox(
            builder,
            attributes,
            13f,
            0.35f,
            8f,
            ROOF,
            18f,
            4.65f,
            -3f
        );

        createWindowRow(
            builder,
            attributes,
            14f,
            -6.55f
        );
    }

